+
+// Forge Diagnostics review screen: parameter confirm + size estimate +
+// warnings, then generation through forge_diag::generate_plate (which gates
+// internally as well). Offline-verified generator; no on-printer claim.
+
+static forge_diag::PlateParams forge_diag_params { 40, 200, 60 };
+static bool forge_diag_overwrite_pending = false;
+
+static bool forge_diag_busy() {
+  return marlin.printingIsActive() || marlin.printingIsPaused() || card.isFileOpen() || planner.has_blocks_queued();
+}
+
+void Draw_ForgeDiagReview()
+{
+  char buf[40];
+  const uint32_t kb = (forge_diag::estimate_plate_bytes(forge_diag_params) + 512ul) / 1024ul;
+  snprintf_P(buf, sizeof(buf), PSTR("Est. size: %lu KB"), (unsigned long)kb);
+  DWIN_Draw_String(false, true, font8x16, Color_White, Color_Bg_Black, LBLX, MBASE(5) + 3, F("                    "));
+  DWIN_Draw_String(false, true, font8x16, Color_White, Color_Bg_Black, LBLX, MBASE(5) + 3, buf);
+  if (forge_diag_busy())
+    Draw_FtmNotice(F("Stop or finish job first"));
+  else if (!card.isMounted())
+    Draw_FtmNotice(F("No SD card"));
+  else if (forge_diag_overwrite_pending)
+    Draw_FtmNotice(F("Press again to OVERWRITE"));
+  else if (forge_diag_params.nozzle_x100 <= 25)
+    Draw_FtmNotice(F("Fine nozzle: multi-hour"));
+  else if (forge_diag_params.nozzle_x100 >= 60)
+    Draw_FtmNotice(F("Zone C probes high flow"));
+  else
+    Draw_FtmNotice(F("Zone C nears flow limit"));
+}
+
+void Draw_ForgeDiagnostics_Menu()
+{
+  Clear_Main_Window();
+  HMI_flag.Refresh_bottom_flag = true;
+
+  Draw_Title(F("Forge Diagnostics"));
+  DWIN_Draw_Label(MBASE(FORGEDIAG_CASE_NOZZLE), F("Nozzle size"));
+  DWIN_Draw_Label(MBASE(FORGEDIAG_CASE_TEMPN), F("Nozzle temp"));
+  DWIN_Draw_Label(MBASE(FORGEDIAG_CASE_TEMPB), F("Bed temp"));
+  DWIN_Draw_Label(MBASE(FORGEDIAG_CASE_GEN), F("Generate test plate"));
+
+  Draw_Back_First();
+  Draw_Menu_Line(FORGEDIAG_CASE_NOZZLE, ICON_HotendTemp);
+  Draw_Menu_Line(FORGEDIAG_CASE_TEMPN, ICON_HotendTemp);
+  Draw_Menu_Line(FORGEDIAG_CASE_TEMPB, ICON_BedTemp);
+  Draw_Menu_Line(FORGEDIAG_CASE_GEN, ICON_PrintSize);
+
+  DWIN_Draw_FloatValue(true, true, 0, font8x16, Color_White, Color_Bg_Black, 2, 2, VALUERANGE_X, MBASE(FORGEDIAG_CASE_NOZZLE) + 3, forge_diag_params.nozzle_x100);
+  DWIN_Draw_IntValue(true, true, 0, font8x16, Color_White, Color_Bg_Black, 3, VALUERANGE_X, MBASE(FORGEDIAG_CASE_TEMPN) + 3, forge_diag_params.temp_nozzle);
+  DWIN_Draw_IntValue(true, true, 0, font8x16, Color_White, Color_Bg_Black, 3, VALUERANGE_X, MBASE(FORGEDIAG_CASE_TEMPB) + 3, forge_diag_params.temp_bed);
+
+  forge_diag_overwrite_pending = false;
+  Draw_ForgeDiagReview();
+}
+
+void HMI_ForgeDiagnostics_Values()
+{
+  ENCODER_DiffState encoder_diffState = get_encoder_state();
+  if (encoder_diffState == ENCODER_DIFF_NO) return;
+  float &val = HMI_ValueStruct.ForgeDiag_scaled;
+  switch (checkkey)
+  {
+  case ForgeDiag_Nozzle:
+    if (Apply_Encoder(encoder_diffState, val))
+    {
+      checkkey = ForgeDiagnostics;
+      EncoderRate.enabled = false;
+      LIMIT(val, 20, 80);
+      forge_diag_params.nozzle_x100 = (uint16_t)(val + 0.5f);
+      forge_diag_overwrite_pending = false;
+      DWIN_Draw_FloatValue(true, true, 0, font8x16, Color_White, Color_Bg_Black, 2, 2, VALUERANGE_X, MBASE(FORGEDIAG_CASE_NOZZLE) + 3, val);
+      Draw_ForgeDiagReview();
+      break;
+    }
+    LIMIT(val, 20, 80);
+    DWIN_Draw_FloatValue(true, true, 0, font8x16, Color_White, Select_Color, 2, 2, VALUERANGE_X, MBASE(FORGEDIAG_CASE_NOZZLE) + 3, val);
+    break;
+  case ForgeDiag_TempN:
+    if (Apply_Encoder(encoder_diffState, val))
+    {
+      checkkey = ForgeDiagnostics;
+      EncoderRate.enabled = false;
+      LIMIT(val, 170, (float)thermalManager.hotend_max_target(0));
+      forge_diag_params.temp_nozzle = (uint16_t)(val + 0.5f);
+      forge_diag_overwrite_pending = false; // any param change disarms a pending overwrite confirm
+      DWIN_Draw_IntValue(true, true, 0, font8x16, Color_White, Color_Bg_Black, 3, VALUERANGE_X, MBASE(FORGEDIAG_CASE_TEMPN) + 3, (uint16_t)val);
+      Draw_ForgeDiagReview();
+      break;
+    }
+    LIMIT(val, 170, (float)thermalManager.hotend_max_target(0));
+    DWIN_Draw_IntValue(true, true, 0, font8x16, Color_White, Select_Color, 3, VALUERANGE_X, MBASE(FORGEDIAG_CASE_TEMPN) + 3, (uint16_t)val);
+    break;
+  case ForgeDiag_TempB:
+    if (Apply_Encoder(encoder_diffState, val))
+    {
+      checkkey = ForgeDiagnostics;
+      EncoderRate.enabled = false;
+      LIMIT(val, 0, BED_MAXTEMP);
+      forge_diag_params.temp_bed = (uint16_t)(val + 0.5f);
+      forge_diag_overwrite_pending = false; // any param change disarms a pending overwrite confirm
+      DWIN_Draw_IntValue(true, true, 0, font8x16, Color_White, Color_Bg_Black, 3, VALUERANGE_X, MBASE(FORGEDIAG_CASE_TEMPB) + 3, (uint16_t)val);
+      Draw_ForgeDiagReview();
+      break;
+    }
+    LIMIT(val, 0, BED_MAXTEMP);
+    DWIN_Draw_IntValue(true, true, 0, font8x16, Color_White, Select_Color, 3, VALUERANGE_X, MBASE(FORGEDIAG_CASE_TEMPB) + 3, (uint16_t)val);
+    break;
+  default:
+    break;
+  }
+  DWIN_UpdateLCD();
+}
+
+void HMI_ForgeDiagnostics()
+{
+  ENCODER_DiffState encoder_diffState = get_encoder_state();
+  if (encoder_diffState == ENCODER_DIFF_NO) return;
+  if (encoder_diffState == ENCODER_DIFF_CW)
+  {
+    if (select_forge_diag.inc(1 + FORGEDIAG_CASE_TOTAL))
+      Move_Highlight(1, select_forge_diag.now);
+  }
+  else if (encoder_diffState == ENCODER_DIFF_CCW)
+  {
+    if (select_forge_diag.dec())
+      Move_Highlight(-1, select_forge_diag.now);
+  }
+  else if (encoder_diffState == ENCODER_DIFF_ENTER)
+  {
+    switch (select_forge_diag.now)
+    {
+    case 0: // Back
+      checkkey = MotionMenu;
+      select_motion.now = MOTION_CASE_DIAGNOSTICS;
+      Draw_Motion_Menu();
+      break;
+    case FORGEDIAG_CASE_NOZZLE:
+      checkkey = ForgeDiag_Nozzle;
+      HMI_ValueStruct.ForgeDiag_scaled = forge_diag_params.nozzle_x100;
+      DWIN_Draw_FloatValue(true, true, 0, font8x16, Color_White, Select_Color, 2, 2, VALUERANGE_X, MBASE(FORGEDIAG_CASE_NOZZLE) + 3, HMI_ValueStruct.ForgeDiag_scaled);
+      EncoderRate.enabled = true;
+      break;
+    case FORGEDIAG_CASE_TEMPN:
+      checkkey = ForgeDiag_TempN;
+      HMI_ValueStruct.ForgeDiag_scaled = forge_diag_params.temp_nozzle;
+      DWIN_Draw_IntValue(true, true, 0, font8x16, Color_White, Select_Color, 3, VALUERANGE_X, MBASE(FORGEDIAG_CASE_TEMPN) + 3, (uint16_t)forge_diag_params.temp_nozzle);
+      EncoderRate.enabled = true;
+      break;
+    case FORGEDIAG_CASE_TEMPB:
+      checkkey = ForgeDiag_TempB;
+      HMI_ValueStruct.ForgeDiag_scaled = forge_diag_params.temp_bed;
+      DWIN_Draw_IntValue(true, true, 0, font8x16, Color_White, Select_Color, 3, VALUERANGE_X, MBASE(FORGEDIAG_CASE_TEMPB) + 3, (uint16_t)forge_diag_params.temp_bed);
+      EncoderRate.enabled = true;
+      break;
+    case FORGEDIAG_CASE_GEN:
+      if (forge_diag_busy()) { Draw_FtmNotice(F("Stop or finish job first")); break; }
+      if (!card.isMounted()) { Draw_FtmNotice(F("No SD card")); break; }
+      if (card.fileExists(FORGE_DIAG_JOB_NAME) && !forge_diag_overwrite_pending)
+      {
+        forge_diag_overwrite_pending = true;
+        Draw_FtmNotice(F("Press again to OVERWRITE"));
+        break;
+      }
+      {
+        forge_diag_overwrite_pending = false;
+        Draw_FtmNotice(F("Generating plate..."));
+        DWIN_UpdateLCD();
+        const bool ok = forge_diag::generate_plate(forge_diag_params, true);
+        Draw_FtmNotice(ok ? F("Plate ready: FORGDIA1.G") : F("Generation failed"));
+      }
+      break;
+    }
+  }
+  DWIN_UpdateLCD();
+}
