 /**
- * GoatTech Forge - diagnostics shared constants.
+ * GoatTech Forge - diagnostics shared constants and generator API.
  *
  * The reserved diagnostic job is generated by the Diagnostics menu as
  * FORGDIA1.TMP and published by rename to FORGDIA1.G (see forge_diag.cpp).
@@ -9,6 +9,28 @@
  */
 #pragma once
 
+#include <stdint.h>
+
 #define FORGE_DIAG_JOB_NAME  "FORGDIA1.G"
 #define FORGE_DIAG_TEMP_NAME "FORGDIA1.TMP"
 #define FORGE_DIAG_SENTINEL  ";FORGE_DIAG_COMPLETE"
+
+namespace forge_diag {
+
+struct PlateParams {
+  uint16_t nozzle_x100;  // installed nozzle diameter x100 (40 = 0.40mm); review-screen parameter
+  uint16_t temp_nozzle;  // confirmed hotend temp, C
+  uint16_t temp_bed;     // confirmed bed temp, C
+};
+
+// Byte count of the plate that generate_plate would emit for these params
+// (runs the same emission path with a counting sink - no drift).
+uint32_t estimate_plate_bytes(const PlateParams &p);
+
+// Generate FORGDIA1.TMP and publish it as FORGDIA1.G. Refuses (returns
+// false) while any job is active or paused, a file is open, the planner has
+// queued blocks, the card is missing, or the job file exists without
+// allow_overwrite. Fail-closed on any SD error.
+bool generate_plate(const PlateParams &p, const bool allow_overwrite);
+
+} // namespace forge_diag
