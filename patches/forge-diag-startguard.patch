+/**
+ * GoatTech Forge - diagnostics shared constants.
+ *
+ * The reserved diagnostic job is generated by the Diagnostics menu as
+ * FORGDIA1.TMP and published by rename to FORGDIA1.G (see forge_diag.cpp).
+ * Both names are guarded at the single SD-job start chokepoint
+ * (CardReader::startOrResumeFilePrinting): the temp name is never runnable,
+ * and the job name runs only when the completion sentinel is present.
+ */
+#pragma once
+
+#define FORGE_DIAG_JOB_NAME  "FORGDIA1.G"
+#define FORGE_DIAG_TEMP_NAME "FORGDIA1.TMP"
+#define FORGE_DIAG_SENTINEL  ";FORGE_DIAG_COMPLETE"
diff --git a/Marlin/src/sd/cardreader.cpp b/Marlin/src/sd/cardreader.cpp
index 1949d9c413..da32ac0b53 100644
--- a/Marlin/src/sd/cardreader.cpp
+++ b/Marlin/src/sd/cardreader.cpp
@@ -32,6 +32,8 @@
 
 #include "cardreader.h"
 
+#include "../e3v3se/forge_diag.h"
+
 #include "../libs/hex_print.h"
 #include "../lcd/marlinui.h"
 
@@ -717,6 +719,42 @@ void CardReader::openAndPrintFile(const char *name) {
  */
 void CardReader::startOrResumeFilePrinting() {
   if (isMounted()) {
+    // GoatTech Forge diagnostics start guard. Every SD job start funnels
+    // through this function (UI file-preview start via openAndPrintFile,
+    // host M23/M24, power-loss resume, autoplay), so the reserved diagnostic
+    // names are refused here, once. Matching uses the canonical DOS 8.3 name
+    // read back from the opened file itself (case-folded), never the
+    // user/host-supplied name or the last-scanned directory entry.
+    {
+      char canon[FILENAME_LENGTH] = { 0 };
+      if (myfile.isOpen()) myfile.getDosName(canon);
+      for (char *p = canon; *p; p++)
+        if (*p >= 'a' && *p <= 'z') *p -= 'a' - 'A';
+      if (!strcmp(canon, FORGE_DIAG_TEMP_NAME)) {
+        SERIAL_ECHOLNPGM("Forge: refusing to start partial diagnostic file");
+        ui.set_status_P(PSTR("Forge: partial diagnostic file - regenerate"));
+        return;
+      }
+      if (!strcmp(canon, FORGE_DIAG_JOB_NAME)) {
+        bool complete = false;
+        if (isFileOpen() && filesize) {
+          const uint32_t tail = filesize < 96 ? filesize : 96;
+          char buf[97];
+          myfile.seekSet(filesize - tail);
+          const int n = myfile.read(buf, tail);
+          myfile.seekSet(sdpos); // restore the job's read position
+          if (n > 0) {
+            buf[(uint32_t)n < 96 ? n : 96] = '\0';
+            complete = strstr(buf, FORGE_DIAG_SENTINEL) != nullptr;
+          }
+        }
+        if (!complete) {
+          SERIAL_ECHOLNPGM("Forge: refusing incomplete diagnostic file");
+          ui.set_status_P(PSTR("Forge: incomplete diagnostic file - regenerate"));
+          return;
+        }
+      }
+    }
     flag.sdprinting = true;
     flag.sdprintdone = false;
     TERN_(SD_RESORT, flush_presort());
