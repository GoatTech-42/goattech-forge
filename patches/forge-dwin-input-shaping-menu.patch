+  // Cycle to the next compiled-in shaper type (wraps around to NONE)
+  ftMotionShaper_t next_ft_shaper(const ftMotionShaper_t s)
+  {
+    for (uint8_t i = 1; i <= 8; i++)
+    {
+      const ftMotionShaper_t c = (ftMotionShaper_t)((s + i) % 9);
+      switch (c)
+      {
+      case ftMotionShaper_NONE: return c;
+#if ENABLED(FTM_SHAPER_ZV)
+      case ftMotionShaper_ZV: return c;
+#endif
+#if ENABLED(FTM_SHAPER_ZVD)
+      case ftMotionShaper_ZVD: return c;
+#endif
+#if ENABLED(FTM_SHAPER_ZVDD)
+      case ftMotionShaper_ZVDD: return c;
+#endif
+#if ENABLED(FTM_SHAPER_ZVDDD)
+      case ftMotionShaper_ZVDDD: return c;
+#endif
+#if ENABLED(FTM_SHAPER_EI)
+      case ftMotionShaper_EI: return c;
+#endif
+#if ENABLED(FTM_SHAPER_2HEI)
+      case ftMotionShaper_2HEI: return c;
+#endif
+#if ENABLED(FTM_SHAPER_3HEI)
+      case ftMotionShaper_3HEI: return c;
+#endif
+#if ENABLED(FTM_SHAPER_MZV)
+      case ftMotionShaper_MZV: return c;
+#endif
+      default: break;
+      }
+    }
+    return ftMotionShaper_NONE;
+  }
