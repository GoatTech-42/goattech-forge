+#ifdef FORGE_TEST_BUILD
+// Test-build report screen: one read-only page to photograph. Turning the
+// knob refreshes the readings; clicking returns to the Diagnostics menu.
+void Draw_ForgeDiagReport()
+{
+  static char lines[FORGE_REPORT_MAX_LINES][FORGE_REPORT_WIDTH];
+  Clear_Main_Window();
+  HMI_flag.Refresh_bottom_flag = true;
+  Draw_Title(F("Forge Report"));
+  const uint8_t n = forge_diag::build_report(lines, FORGE_REPORT_MAX_LINES);
+  for (uint8_t i = 0; i < n; i++)
+    DWIN_Draw_String(false, true, font8x16, Color_White, Color_Bg_Black, 8, 40 + i * 22, lines[i]);
+  DWIN_UpdateLCD();
+}
+
+void HMI_ForgeDiagReport()
+{
+  ENCODER_DiffState encoder_diffState = get_encoder_state();
+  if (encoder_diffState == ENCODER_DIFF_NO) return;
+  if (encoder_diffState == ENCODER_DIFF_ENTER)
+  {
+    checkkey = ForgeDiagnostics;
+    select_forge_diag.now = FORGEDIAG_CASE_RUN;
+    Draw_ForgeDiagnostics_Menu();
+    Erase_Menu_Cursor(0);
+    Draw_Menu_Cursor(FORGEDIAG_CASE_RUN);
+    DWIN_UpdateLCD();
+  }
+  else
+    Draw_ForgeDiagReport(); // CW/CCW: refresh readings
+}
+#endif
