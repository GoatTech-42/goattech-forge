   return true;
 }
 
+#ifdef FORGE_TEST_BUILD
+// ---------------- read-only report (test builds only) ---------------------
+
+static void put_line(char out[][FORGE_REPORT_WIDTH], uint8_t &n, const uint8_t max, const char *fmt, ...) {
+  if (n >= max) return;
+  va_list ap; va_start(ap, fmt);
+  vsnprintf(out[n], FORGE_REPORT_WIDTH, fmt, ap);
+  va_end(ap);
+  out[n][FORGE_REPORT_WIDTH - 1] = '\0';
+  n++;
+}
+
+uint8_t build_report(char out[][FORGE_REPORT_WIDTH], const uint8_t max) {
+  uint8_t n = 0;
+  put_line(out, n, max, "%s", FORGE_VERSION_LABEL);
+  put_line(out, n, max, "base %s", SHORT_BUILD_VERSION);
+  put_line(out, n, max, "board %s", BOARD_INFO_NAME);
+  put_line(out, n, max, "up %lus  sd %s", (unsigned long)(millis() / 1000UL), card.isMounted() ? "[ok]" : "[none]");
+
+  const int16_t hn = (int16_t)(thermalManager.degHotend(0) + 0.5f), hb = (int16_t)(thermalManager.degBed() + 0.5f);
+  const int16_t tn = (int16_t)thermalManager.degTargetHotend(0), tb = (int16_t)thermalManager.degTargetBed();
+  const bool sens_n = hn > HEATER_0_MINTEMP && hn < (HEATER_0_MAXTEMP - 10);
+  const bool sens_b = hb > BED_MINTEMP && hb < (BED_MAXTEMP - 5);
+  put_line(out, n, max, "nozzle %d/%d C %s", hn, tn, sens_n ? "[ok]" : "[check]");
+  put_line(out, n, max, "bed    %d/%d C %s", hb, tb, sens_b ? "[ok]" : "[check]");
+  put_line(out, n, max, "heaters %s", (tn == 0 && tb == 0) ? "[off]" : "[ON]");
+  put_line(out, n, max, "thermal prot noz %s bed %s",
+    #if ENABLED(THERMAL_PROTECTION_HOTENDS)
+      "[on]",
+    #else
+      "[OFF]",
+    #endif
+    #if ENABLED(THERMAL_PROTECTION_BED)
+      "[on]"
+    #else
+      "[OFF]"
+    #endif
+  );
+  put_line(out, n, max, "max temp noz %d bed %d", (int)thermalManager.hotend_max_target(0), (int)BED_MAXTEMP);
+  {
+    char zo[14]; dtostrf(probe.offset.z, 0, 2, zo);
+    put_line(out, n, max, "z offset %s mm", zo);
+  }
+  put_line(out, n, max, "leveling %s",
+    #if HAS_LEVELING
+      planner.leveling_active ? "[on]" : "[off]"
+    #else
+      "[n/a]"
+    #endif
+  );
+  {
+    char k[14]; dtostrf(planner.extruder_advance_K[0], 0, 3, k);
+    put_line(out, n, max, "accel %d  lin adv K %s", (int)planner.settings.acceleration, k);
+  }
+  put_line(out, n, max, "s-curve %s  plr %s",
+    #if ENABLED(S_CURVE_ACCELERATION)
+      "[on]",
+    #else
+      "[off]",
+    #endif
+    #if ENABLED(POWER_LOSS_RECOVERY)
+      recovery.enabled ? "[on]" : "[off]"
+    #else
+      "[n/a]"
+    #endif
+  );
+  if (card.isMounted()) {
+    put_line(out, n, max, "FORGDIA1.G %s tmp %s",
+      card.fileExists(FORGE_DIAG_JOB_NAME) ? "[yes]" : "[none]",
+      card.fileExists(FORGE_DIAG_TEMP_NAME) ? "[STALE]" : "[none]");
+  }
+  else put_line(out, n, max, "FORGDIA1.G [no sd]");
+  put_line(out, n, max, "read-only: no heat, no motion");
+  put_line(out, n, max, "click to go back");
+  return n;
+}
+#endif // FORGE_TEST_BUILD
+
 } // namespace forge_diag
